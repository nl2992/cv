% cv.sty — shared layout for every CV version in this folder.
% Compile with XeLaTeX (or tectonic); see latex/README.md.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv}[2026/09/28 Nigel Li CV style]

% ---------------------------------------------------------------- page
\RequirePackage[letterpaper,top=0.45in,bottom=0.45in,left=0.5in,right=0.5in]{geometry}
\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\raggedbottom

% ---------------------------------------------------------------- fonts
% TeX Gyre Termes: a Times clone that ships with every TeX distribution, so
% the output is identical on any machine. (Not Times New Roman: its shared
% ";"/U+037E glyph makes XeTeX write Greek question marks into the PDF text
% layer, which breaks copy/paste and ATS parsing.)
\RequirePackage{fontspec}
\setmainfont{texgyretermes}[Extension=.otf, UprightFont=*-regular,
  BoldFont=*-bold, ItalicFont=*-italic, BoldItalicFont=*-bolditalic,
  Ligatures={NoCommon, TeX}]  % no ff/fi ligatures: keeps text ATS-searchable
% Chinese name (李永沛): Songti TC on macOS, Noto Serif CJK TC elsewhere.
\IfFontExistsTF{Songti TC}
  {\newfontfamily\cjkfont{Songti TC}}
  {\IfFontExistsTF{Noto Serif CJK TC}
    {\newfontfamily\cjkfont{Noto Serif CJK TC}}
    {\newcommand\cjkfont{}}}
\newcommand{\cjk}[1]{{\cjkfont #1}}

% ---------------------------------------------------------------- links
\RequirePackage{xcolor}
\definecolor{linkblue}{RGB}{5,99,193}
\RequirePackage[hidelinks,pdfusetitle]{hyperref}
\RequirePackage[normalem]{ulem}
% \cvlink{url}{text}: clickable, blue and underlined like the Word originals.
\newcommand{\cvlink}[2]{\href{#1}{\textcolor{linkblue}{\uline{#2}}}}

% URLs used across versions — edit once here.
\newcommand{\urlLinkedIn}{https://www.linkedin.com/in/nigelli2/}
% Stable iaqf.org path; it redirects to a freshly signed CDN link each visit
% (the signed CDN URL itself expires, so never paste that one in).
\newcommand{\urlIAQF}{https://iaqf.org/resources/Documents/2026\%20Student\%20Competition/The\%20IAQF\%20Announces\%20the\%20Winners\%20of\%20the\%20Fifteenth\%20Annual\%20IAQF\%20Academic\%20Affiliate\%20Membership\%20Student\%20Competition\%202026.pdf}
\newcommand{\urlWellingtonMemo}{https://drive.google.com/file/d/1LHG9Feg93OHprW_CDEPQ8rMyWZeEsPPE/view}

\newcommand{\email}[1]{\cvlink{mailto:#1}{#1}}
\newcommand{\linkedin}{\cvlink{\urlLinkedIn}{Linkedin}}

% ---------------------------------------------------------------- header
% \cvheader{NAME}{contact line}  — optional extra lines follow as \cvheaderline.
\newcommand{\cvheader}[2]{%
  \begin{center}
    {\fontsize{14}{16}\selectfont\bfseries #1}\\[1pt]
    {\fontsize{10.5}{12.5}\selectfont #2}%
}
\newcommand{\cvheaderline}[1]{\\{\fontsize{10.5}{12.5}\selectfont #1}}
\newcommand{\cvheaderend}{\end{center}\vspace{-6pt}}
\newcommand{\sep}{\ \textbar\ }

% ---------------------------------------------------------------- body
\newcommand{\cvbodysize}{\fontsize{10.5}{12}\selectfont}
% Ragged-right with no hyphenation, like the Word originals.
\AtBeginDocument{\cvbodysize\raggedright}
\hyphenpenalty=10000 \exhyphenpenalty=10000

% \cvsection{TITLE}: bold caps heading with a full-width rule.
\newcommand{\cvsection}[1]{%
  \par\vspace{8pt}%
  {\fontsize{11}{13}\selectfont\bfseries #1}\par\vspace{1.5pt}%
  \hrule height 0.6pt\relax\vspace{2pt}%
}

% \cventry{Organisation}{Location}{Role / degree}{Dates}
\newcommand{\cventry}[4]{%
  \par{\bfseries #1}\hfill #2\par
  {\itshape #3}\hfill #4\par
}
\newcommand{\entrygap}{\par\vspace{6pt}}

\RequirePackage{enumitem}
\setlist[itemize]{label={\fontsize{8}{8}\selectfont\raisebox{0.1ex}{$\bullet$}},
  leftmargin=0.3in, labelsep=0.12in, itemsep=0pt, parsep=0pt, topsep=0pt,
  partopsep=0pt}

% Smaller list for the skills block, with bold labels.
\newenvironment{cvskills}
  {\begin{itemize}\fontsize{9.5}{11}\selectfont}
  {\end{itemize}}
\newcommand{\skill}[2]{\item \textbf{#1:} #2}

\endinput
