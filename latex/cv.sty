% cv.sty — shared layout for every CV version in this folder.
% Compile with XeLaTeX (or tectonic); see latex/README.md.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv}[2026/09/28 Nigel Li CV style]

% ---------------------------------------------------------------- page
% Layout after Jake Gutierrez's "Jake's Resume" template (MIT licence).
\RequirePackage[letterpaper,top=0.5in,bottom=0.5in,left=0.5in,right=0.5in]{geometry}
\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\tabcolsep}{0in}
\raggedbottom

% ---------------------------------------------------------------- fonts
% Latin Modern (Computer Modern), as in Jake's template, loaded by filename so
% it works under tectonic, XeLaTeX and Overleaf alike. Common ligatures are off
% so words like "Office" stay searchable by ATS parsers.
\RequirePackage{fontspec}
\setmainfont{lmroman10}[Extension=.otf, UprightFont=*-regular,
  BoldFont=*-bold, ItalicFont=*-italic, BoldItalicFont=*-bolditalic,
  SmallCapsFont=lmromancaps10-regular, Ligatures={NoCommon, TeX}]
% Chinese name (李永沛): Songti TC on macOS, Noto Serif CJK TC elsewhere.
\IfFontExistsTF{Songti TC}
  {\newfontfamily\cjkfont{Songti TC}}
  {\IfFontExistsTF{Noto Serif CJK TC}
    {\newfontfamily\cjkfont{Noto Serif CJK TC}}
    {\newcommand\cjkfont{}}}
\newcommand{\cjk}[1]{{\cjkfont #1}}

% ---------------------------------------------------------------- links
\RequirePackage{xcolor}
\RequirePackage[hidelinks,pdfusetitle]{hyperref}
\urlstyle{same}
\RequirePackage[normalem]{ulem}
% \cvlink{url}{text}: clickable, underlined in black (Jake's style).
\newcommand{\cvlink}[2]{\href{#1}{\uline{#2}}}

% URLs used across versions — edit once here.
\newcommand{\urlLinkedIn}{https://www.linkedin.com/in/nigelli2/}
\newcommand{\urlGitHub}{https://github.com/nl2992}
% Stable iaqf.org path; it redirects to a freshly signed CDN link each visit
% (the signed CDN URL itself expires, so never paste that one in).
\newcommand{\urlIAQF}{https://iaqf.org/resources/Documents/2026\%20Student\%20Competition/The\%20IAQF\%20Announces\%20the\%20Winners\%20of\%20the\%20Fifteenth\%20Annual\%20IAQF\%20Academic\%20Affiliate\%20Membership\%20Student\%20Competition\%202026.pdf}
\newcommand{\urlWellingtonMemo}{https://drive.google.com/file/d/1LHG9Feg93OHprW_CDEPQ8rMyWZeEsPPE/view}

\newcommand{\email}[1]{\cvlink{mailto:#1}{#1}}
\newcommand{\linkedin}{\cvlink{\urlLinkedIn}{Linkedin}}
\newcommand{\github}{\cvlink{\urlGitHub}{GitHub}}

% ---------------------------------------------------------------- header
% \cvheader{Name}{contact line}  — optional extra lines follow as \cvheaderline.
\newcommand{\cvheader}[2]{%
  \begin{center}
    {\huge\scshape #1}\\[3pt]
    {\small #2}%
}
\newcommand{\cvheaderline}[1]{\\[1pt]{\small #1}}
\newcommand{\cvheaderend}{\end{center}\vspace{-10pt}}
\newcommand{\sep}{\ $|$\ }

% ---------------------------------------------------------------- body
\AtBeginDocument{\raggedright}

% \cvsection{Title}: small caps with a full-width rule.
\newcommand{\cvsection}[1]{%
  \par\vspace{6pt}%
  {\large\scshape #1}\par\vspace{1pt}%
  \hrule height 0.4pt\relax\vspace{4pt}%
}

% \cventry{Organisation}{Location}{Role / degree}{Dates}
\newcommand{\cvindent}{0.15in}
\newcommand{\cventry}[4]{%
  \par\hspace*{\cvindent}%
  \begin{tabular*}{\dimexpr0.97\textwidth-\cvindent}[t]{l@{\extracolsep{\fill}}r}
    \textbf{#1} & #2 \\
    \textit{\small #3} & \textit{\small #4} \\
  \end{tabular*}\par\vspace{-1pt}%
}
\newcommand{\entrygap}{\par\vspace{4pt}}

\RequirePackage{enumitem}
\setlist[itemize]{label={$\vcenter{\hbox{\tiny$\bullet$}}$},
  leftmargin=\dimexpr\cvindent+1.6em\relax, itemsep=-1pt, parsep=0pt,
  topsep=1pt, partopsep=0pt, before=\small}

% Skills block: no bullets, bold labels, like Jake's "Technical Skills".
\newenvironment{cvskills}
  {\begin{itemize}[label={}, leftmargin=\cvindent, itemsep=0pt]}
  {\end{itemize}}
\newcommand{\skill}[2]{\item \textbf{#1}{: #2}}

\endinput
